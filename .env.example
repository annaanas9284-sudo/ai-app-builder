# Copy this file to ".env" (same folder) and fill in the two GitHub lines to turn on cloud builds.
# Lines starting with # are comments.

# Fine-grained GitHub token with "Contents: Read and write" and "Actions: Read and write"
# on ONLY your build repository. Keep it secret.
GITHUB_TOKEN=

# Your build repository as owner/name, e.g. jane/my-app-builds
GITHUB_REPO=

# Optional
# GITHUB_BRANCH=main
# PORT=3000
# HOST=127.0.0.1
# DATA_DIR=./data
